PORT=5000
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CoinRemitter Crypto Payments (USDT-TRC20)
COINREMITTER_API_KEY=your_coinremitter_api_key
COINREMITTER_PASSWORD=your_coinremitter_password
COINREMITTER_WALLET=USDT-TRC20

# Webhook URL — set this to your public backend URL (e.g. https://yourdomain.com)
# For local dev use ngrok: https://abc123.ngrok.io
COINREMITTER_WEBHOOK_URL=https://your-backend-url.com/api/crypto/webhook

# Frontend URL (used for redirect after payment)
FRONTEND_URL=https://your-frontend-url.com
